{
  "name": "hotelna",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "db:migrate:local": "wrangler d1 migrations apply hotelna --local",
    "db:seed:local": "wrangler d1 execute hotelna --local --file=db/seed.sql",
    "preview": "wrangler pages dev dist --d1 DB=00000000-0000-0000-0000-000000000000 --port 8788",
    "deploy": "npm run build && wrangler pages deploy dist"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/readex-pro": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "hono": "^4.13.19",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.75.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.11.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261118.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "puppeteer-core": "^25.18.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.164.0"
  }
}
